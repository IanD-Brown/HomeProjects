    "views": [
      {
        "viewName": "TrialsView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT DISTINCT tc.name, tc.yearGroup, tc.gender, t.date FROM Nominations n, TeamCategories tc, Trials t WHERE UPPER(n.whichYearGroupIsYourChildInNow) = tc.yearGroup AND UPPER(n.gender) = tc.gender AND t.nominee = n.id ORDER BY name, date ASC"
      },
      {
        "viewName": "TrialDetailsView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT n.firstNameOfChild, n.surnameOfChild, n.gender, n.whichYearGroupIsYourChildInNow, n.primaryPosition, n.secondaryPosition, n.foot, t.date FROM Nominations n, Trials t WHERE  t.nominee = n.id ORDER BY surnameOfChild, firstNameOfChild"
      }
